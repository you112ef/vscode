{
	"name": "VS Code Web - Cloudflare Pages",
	"short_name": "VS Code Web",
	"description": "VS Code Web Editor optimized for Cloudflare Pages with responsive design for all devices",
	"start_url": "./",
	"display": "standalone",
	"background_color": "#1e1e1e",
	"theme_color": "#007acc",
	"orientation": "any",
	"scope": "./",
	"lang": "en",
	"dir": "ltr",
	"categories": [
		"development",
		"productivity",
		"utilities"
	],
	"icons": [
		{
			"src": "./out-build/vs/workbench/browser/media/code-icon.svg",
			"sizes": "any",
			"type": "image/svg+xml",
			"purpose": "any maskable"
		},
		{
			"src": "./out-build/vs/workbench/browser/media/code-icon.svg",
			"sizes": "192x192",
			"type": "image/svg+xml",
			"purpose": "any"
		},
		{
			"src": "./out-build/vs/workbench/browser/media/code-icon.svg",
			"sizes": "512x512",
			"type": "image/svg+xml",
			"purpose": "any"
		}
	],
	"shortcuts": [
		{
			"name": "New File",
			"short_name": "New File",
			"description": "Create a new file",
			"url": "./?action=new-file",
			"icons": [
				{
					"src": "./out-build/vs/workbench/browser/media/code-icon.svg",
					"sizes": "96x96"
				}
			]
		},
		{
			"name": "Open Folder",
			"short_name": "Open Folder",
			"description": "Open a folder",
			"url": "./?action=open-folder",
			"icons": [
				{
					"src": "./out-build/vs/workbench/browser/media/code-icon.svg",
					"sizes": "96x96"
				}
			]
		}
	],
	"related_applications": [],
	"prefer_related_applications": false,
	"edge_side_panel": {
		"preferred_width": 400
	},
	"launch_handler": {
		"client_mode": "focus-existing"
	},
	"protocol_handlers": [
		{
			"protocol": "vscode",
			"url": "./?uri=%s"
		}
	],
	"file_handlers": [
		{
			"action": "./",
			"accept": {
				"text/*": [".txt", ".md", ".js", ".ts", ".html", ".css", ".json", ".xml", ".py", ".java", ".cpp", ".c", ".h", ".php", ".rb", ".go", ".rs", ".swift", ".kt", ".scala", ".clj", ".hs", ".ml", ".fs", ".vb", ".cs", ".sql", ".sh", ".bat", ".ps1", ".yaml", ".yml", ".toml", ".ini", ".cfg", ".conf", ".log", ".csv", ".tsv", ".xml", ".svg", ".html", ".htm", ".xhtml", ".shtml", ".jsp", ".asp", ".aspx", ".php", ".jsp", ".erb", ".haml", ".slim", ".pug", ".ejs", ".hbs", ".mustache", ".handlebars", ".liquid", ".twig", ".smarty", ".velocity", ".freemarker", ".thymeleaf", ".gsp", ".rhtml", ".rxml", ".erb", ".haml", ".slim", ".pug", ".ejs", ".hbs", ".mustache", ".handlebars", ".liquid", ".twig", ".smarty", ".velocity", ".freemarker", ".thymeleaf", ".gsp", ".rhtml", ".rxml"]
			}
		}
	],
	"share_target": {
		"action": "./",
		"method": "GET",
		"params": {
			"title": "title",
			"text": "text",
			"url": "url"
		}
	},
	"permissions": [
		"clipboard-read",
		"clipboard-write",
		"notifications"
	],
	"display_override": [
		"standalone",
		"minimal-ui",
		"window-controls-overlay"
	]
}